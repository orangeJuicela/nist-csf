---
import Base from "../../layouts/Base.astro";
import Pager from "../../components/Pager.astro";
import {
  categories,
  childrenOf,
  getElement,
  elementHref,
  missingSubcategoryIds,
  slug,
  href,
  type CatalogElement,
} from "../../lib/catalog";
import { categoryGuide } from "../../content/guide";

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { id: slug(cat.id) },
    props: { cat },
  }));
}

interface Props {
  cat: CatalogElement;
}

const { cat } = Astro.props;
const fn = getElement(cat.parentId ?? "");
const guide = categoryGuide(cat.id);
const subs = childrenOf(cat.id);
const gaps = missingSubcategoryIds(cat.id);
const crumbs = [
  { href: href(), label: "開始" },
  { href: elementHref(fn), label: fn.navLabelZhTW ?? fn.id },
  { label: cat.navLabelZhTW ?? cat.id },
];
---

<Base title={cat.navLabelZhTW ?? cat.id} description={guide.line} currentId={cat.id} crumbs={crumbs}>
  <article class="read">
    <header class="opening" data-fn={fn.id}>
      <p class="eyebrow"><a href={elementHref(fn)}>{fn.navLabelZhTW}</a></p>
      <h1>{cat.navLabelZhTW}</h1>
      <p class="lead">{guide.line}</p>
      <p class="analogy">比方：{guide.example}</p>
    </header>

    <p>下面每一句是白話。編號和官方英文收起來了，需要對條文時再打開。</p>

    <ol class="plain-list">
      {
        subs.map((sub) => (
          <li id={sub.id}>
            <p>{sub.explanationZhTW}</p>
            <details class="official-fold">
              <summary>看官方條文</summary>
              <p class="mono">{sub.id}</p>
              <p lang="en">{sub.outcome}</p>
            </details>
          </li>
        ))
      }
    </ol>

    <details class="official-fold">
      <summary>看這一類的官方英文</summary>
      <p class="kicker">官方英文成果敘述</p>
      <p lang="en">{cat.outcome}</p>
      <p class="kicker">非官方說明</p>
      <p>{cat.explanationZhTW}</p>
      {
        gaps.length > 0 && (
          <p>
            編號有空號（{gaps.join("、")}）。這是 CSF 2.0 刻意留下的，代表舊版條文已移到別處，不是漏收。
          </p>
        )
      }
    </details>

    <Pager id={cat.id} />
  </article>
</Base>
