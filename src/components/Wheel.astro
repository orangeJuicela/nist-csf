---
import { functions, elementHref } from "../lib/catalog";

const center = functions.find((fn) => fn.id === "GV");
const ring = functions.filter((fn) => fn.id !== "GV");
if (!center) throw new Error("Govern missing");

const cx = 320;
const cy = 320;
const inner = 128;
const outer = 292;
const gap = 0.035;
const sweep = (Math.PI * 2) / ring.length;

function polar(radius: number, angle: number): [number, number] {
  return [cx + radius * Math.cos(angle), cy + radius * Math.sin(angle)];
}

function sector(start: number, end: number): string {
  const large = end - start > Math.PI ? 1 : 0;
  const [x0, y0] = polar(outer, start);
  const [x1, y1] = polar(outer, end);
  const [x2, y2] = polar(inner, end);
  const [x3, y3] = polar(inner, start);
  return `M ${x0} ${y0} A ${outer} ${outer} 0 ${large} 1 ${x1} ${y1} L ${x2} ${y2} A ${inner} ${inner} 0 ${large} 0 ${x3} ${y3} Z`;
}

const slices = ring.map((fn, index) => {
  const start = -Math.PI / 2 + sweep * index + gap / 2;
  const end = -Math.PI / 2 + sweep * (index + 1) - gap / 2;
  const mid = (start + end) / 2;
  const [lx, ly] = polar((inner + outer) / 2, mid);
  return { fn, d: sector(start, end), lx, ly };
});
---

<figure class="wheel-wrap">
  <svg class="wheel-svg" viewBox="0 0 640 640" role="group" aria-label="CSF 2.0 圖。治理在中央。外圈依序是識別、保護、偵測、應變、復原。每一塊可以點進去。">
    {
      slices.map((slice) => (
        <a href={elementHref(slice.fn)} data-fn={slice.fn.id} aria-label={slice.fn.navLabelZhTW ?? slice.fn.id}>
          <path d={slice.d} />
          <text x={slice.lx} y={slice.ly} text-anchor="middle" dominant-baseline="middle" font-size="30" font-weight="700">
            {slice.fn.navLabelZhTW}
          </text>
        </a>
      ))
    }
    <a href={elementHref(center)} data-fn="GV" aria-label={center.navLabelZhTW ?? "治理"}>
      <circle cx={cx} cy={cy} r="108" />
      <text x={cx} y={cy} text-anchor="middle" dominant-baseline="middle" font-size="36" font-weight="700">
        {center.navLabelZhTW}
      </text>
    </a>
  </svg>
  <figcaption class="wheel-note">治理在中間。點一塊，就進到那一件。</figcaption>
</figure>
