---
interface Props {
  id: string;
}

const { id } = Astro.props;

const sketches: Record<string, { aria: string; steps: { icon: string; label: string }[] }> = {
  GV: {
    aria: "治理：先講好誰負責，寫成規矩，再回頭看。",
    steps: [
      { icon: "people", label: "講好誰負責" },
      { icon: "doc", label: "寫成規矩" },
      { icon: "cycle", label: "回頭看" },
    ],
  },
  ID: {
    aria: "識別：先列出有什麼，再看哪裡會出事。",
    steps: [
      { icon: "boxes", label: "列出有什麼" },
      { icon: "search", label: "看哪裡危險" },
      { icon: "list", label: "排優先順序" },
    ],
  },
  PR: {
    aria: "保護：上鎖，鑰匙只給該有的人，備份另外放。",
    steps: [
      { icon: "lock", label: "先上鎖" },
      { icon: "key", label: "鑰匙給對的人" },
      { icon: "disk", label: "備份分開放" },
    ],
  },
  DE: {
    aria: "偵測：平常看著，有異狀就響，有人會看。",
    steps: [
      { icon: "eye", label: "平常看著" },
      { icon: "bell", label: "有異狀就響" },
      { icon: "screen", label: "有人會看" },
    ],
  },
  RS: {
    aria: "應變：發現出事，先隔離，再通知該知道的人。",
    steps: [
      { icon: "alert", label: "發現出事" },
      { icon: "unplug", label: "先隔離" },
      { icon: "megaphone", label: "通知該知道的人" },
    ],
  },
  RC: {
    aria: "復原：檔案受影響後，用備份救回，再確認能工作。",
    steps: [
      { icon: "broken", label: "工作受影響" },
      { icon: "restore", label: "用備份救回" },
      { icon: "check", label: "確認能工作" },
    ],
  },
};

const sketch = sketches[id];
if (!sketch) throw new Error(`missing sketch ${id}`);
---

<figure class="sketch" data-fn={id} aria-label={sketch.aria}>
  <ol>
    {
      sketch.steps.map((step) => (
        <li>
          <span class="sketch-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              {step.icon === "people" && (
                <g>
                  <circle cx="12" cy="11" r="3" />
                  <circle cx="21" cy="12" r="2.4" />
                  <path d="M6 23c.8-4 3.4-6 6-6s5.2 2 6 6" />
                  <path d="M17 23c.5-2.6 2.2-4 4-4 1.4 0 2.6.7 3.4 2.4" />
                </g>
              )}
              {step.icon === "doc" && (
                <g>
                  <path d="M9 6h10l5 5v15H9z" />
                  <path d="M19 6v5h5M12 16h8M12 20h6" />
                </g>
              )}
              {step.icon === "cycle" && (
                <g>
                  <path d="M16 8a8 8 0 1 1-3 1.2" />
                  <path d="M16 5v5h5" />
                </g>
              )}
              {step.icon === "boxes" && (
                <g>
                  <rect x="6" y="15" width="9" height="9" />
                  <rect x="15" y="8" width="9" height="9" />
                </g>
              )}
              {step.icon === "search" && (
                <g>
                  <circle cx="14" cy="14" r="6" />
                  <path d="M19 19l6 6" />
                </g>
              )}
              {step.icon === "list" && (
                <g>
                  <path d="M8 10h16M8 16h16M8 22h11" />
                </g>
              )}
              {step.icon === "lock" && (
                <g>
                  <rect x="9" y="14" width="14" height="11" rx="2" />
                  <path d="M12 14v-3a4 4 0 0 1 8 0v3" />
                </g>
              )}
              {step.icon === "key" && (
                <g>
                  <circle cx="12" cy="16" r="4" />
                  <path d="M16 16h10M22 16v3M25 16v3" />
                </g>
              )}
              {step.icon === "disk" && (
                <g>
                  <rect x="7" y="8" width="18" height="16" rx="2" />
                  <path d="M7 13h18M12 20h8" />
                </g>
              )}
              {step.icon === "eye" && (
                <g>
                  <path d="M4 16s4.5-7 12-7 12 7 12 7-4.5 7-12 7-12-7-12-7z" />
                  <circle cx="16" cy="16" r="3" />
                </g>
              )}
              {step.icon === "bell" && (
                <g>
                  <path d="M16 7a6 6 0 0 1 6 6v4l2 3H8l2-3v-4a6 6 0 0 1 6-6z" />
                  <path d="M14 23a2 2 0 0 0 4 0" />
                </g>
              )}
              {step.icon === "screen" && (
                <g>
                  <rect x="6" y="8" width="20" height="13" rx="1.5" />
                  <path d="M12 25h8M16 21v4" />
                </g>
              )}
              {step.icon === "alert" && (
                <g>
                  <path d="M16 6l11 18H5z" />
                  <path d="M16 13v5M16 21.5h.01" />
                </g>
              )}
              {step.icon === "unplug" && (
                <g>
                  <path d="M12 7v6M20 7v6" />
                  <rect x="9" y="13" width="14" height="8" rx="2" />
                  <path d="M16 21v5" />
                </g>
              )}
              {step.icon === "megaphone" && (
                <g>
                  <path d="M7 14h5l9-5v14l-9-5H7z" />
                  <path d="M7 14v6h5" />
                </g>
              )}
              {step.icon === "broken" && (
                <g>
                  <rect x="9" y="7" width="14" height="18" />
                  <path d="M12 13l8 7M20 13l-8 7" />
                </g>
              )}
              {step.icon === "restore" && (
                <g>
                  <rect x="8" y="15" width="16" height="10" />
                  <path d="M16 6v8M12 10l4 4 4-4" />
                </g>
              )}
              {step.icon === "check" && (
                <g>
                  <path d="M7 16l6 6L25 9" />
                </g>
              )}
            </svg>
          </span>
          <span>{step.label}</span>
        </li>
      ))
    }
  </ol>
</figure>
